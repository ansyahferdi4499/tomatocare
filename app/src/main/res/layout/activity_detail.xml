<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_paper"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".DetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="20dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_baseline_keyboard_backspace_24"
            android:tint="@color/forest" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.12"
            android:text="@string/detail_eyebrow"
            android:textColor="@color/quiet"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageViewPenyakit"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:contentDescription="@string/leaf_icon"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/textViewJudul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/forest"
            android:textSize="30sp"
            tools:text="Penyakit Daun Tomat" />

        <TextView
            android:id="@+id/textViewDeskripsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/quiet"
            android:textSize="16sp"
            tools:text="Informasi gejala pada daun tomat" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/line_subtle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/detail_section_title"
            android:textColor="@color/forest"
            android:textSize="19sp"
            android:fontFamily="sans-serif-medium" />

        <WebView
            android:id="@+id/webViewPenjelasan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="140dp"
            android:background="@android:color/transparent"
            android:overScrollMode="never" />
    </LinearLayout>
</ScrollView>
