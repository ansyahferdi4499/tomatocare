<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon_tomato_leaf"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon_tomato_leaf"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pepey"
        tools:targetApi="31"
        android:requestLegacyExternalStorage="true">

        <!-- SplashScreenActivity sebagai entry point -->
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.Pepey">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity tidak diekspor -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- DetailActivity digunakan secara internal -->
        <activity
            android:name=".DetailActivity"
            android:exported="false" />
        <activity
            android:name=".InformasiActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".CameraActivity"
            android:exported="false" />
        <activity
            android:name=".ImageUploadActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- DeteksiActivity juga digunakan secara internal -->
        <activity
            android:name=".InfoActivity"
            android:exported="false" />

    </application>
</manifest>
